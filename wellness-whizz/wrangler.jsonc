{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wellness-whizz",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run the Worker; everything else is served straight from the static assets.
    "run_worker_first": ["/", "/api/*", "/result/*", "/supplement/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wellness-whizz",
      // Replace with the id printed by `wrangler d1 create wellness-whizz`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "PRODUCT_SEARCH_URL": "https://www.amazon.com/s?k={query}",
    "RATE_LIMIT_PER_HOUR": "10"
  },
  "observability": { "enabled": true }
}
