{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wellness-whizz",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run the Worker; everything else is served straight from the static assets.
    "run_worker_first": ["/", "/api/*", "/result/*", "/supplement/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wellness-whizz",
      // Replace with the id printed by `wrangler d1 create wellness-whizz`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "PRODUCT_SEARCH_URL": "https://www.amazon.com/s?k={query}",
    // Abuse controls for the (paid) quiz endpoint: per-IP and global submissions per hour, 0 disables.
    "RATE_LIMIT_PER_HOUR": "10",
    "GLOBAL_LIMIT_PER_HOUR": "100",
    // "false" keeps supplements created by the AI out of the home slider, the Explore list and /api/supplements
    // (their own pages and result pages still work).
    "LIST_AI_SUPPLEMENTS": "true",
    // Optional Cloudflare Turnstile bot protection: set the site key here and the secret with
    // `wrangler secret put TURNSTILE_SECRET_KEY`.
    "TURNSTILE_SITE_KEY": ""
  },
  "observability": { "enabled": true }
}
